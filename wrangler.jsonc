{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-astro-web-app",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [{
    "name": "AUTH_LIMIT",
    "namespace_id": "21904",
    "simple": { "limit": 8, "period": 60 }
  }]
}
